# ---------------------------------------------------------------- api
DATABASE_URL=postgres://tender:tender@localhost:5432/tender?sslmode=disable
PORT=8080
CORS_ORIGIN=http://localhost:3000

# Note recognition. Production always uses claude; the service refuses to start
# in this mode without a key, rather than accepting every pledge unscreened.
VISION_MODE=claude
ANTHROPIC_API_KEY=

# Which model does the counting. Pick this from measured accuracy and cost --
# `go run ./cmd/eval` against your own labelled photographs -- not from intuition.
VISION_MODEL=claude-haiku-4-5

# Platform fee, in basis points of the transferred amount (50 = 0.5%).
FEE_BPS=50

# How long a counterparty's funds stay locked waiting for the meet-up, how long
# a transfer may stay open overall, and how often expiry is swept.
MATCH_TTL=30m
TRANSFER_TTL=2h
CREDIT_TTL=1h
SWEEP_INTERVAL=15s

# Tier 1 instant credit: settlements required to unlock, and the opening limit.
SETTLEMENTS_FOR_CREDIT=3
CREDIT_LIMIT_KOBO=500000

# The most cash that may change hands in one meeting (default ₦100,000). Large
# amounts make a handover worth targeting, so big transfers are refused rather
# than concentrated into a single trip.
MAX_HANDOVER_KOBO=10000000

# Handovers are matched only during a venue's opening hours. Set to false ONLY
# in tests, so a run outside business hours can still match.
ENFORCE_VENUE_HOURS=true

# Apply migrations on boot. The deployment target has no pre-deploy hook, and
# the migrations are embedded in the binary, so this is how the schema moves.
# It is idempotent and guarded by an advisory lock, so several instances
# starting at once is fine.
MIGRATE_ON_START=true

# ---------------------------------------------------------------- fintava
# The bank rail: name enquiry before a send, and the payout that delivers a
# settled transfer. Without a key both are unavailable, and the API says so
# rather than accepting transfers it cannot complete.
FINTAVA_BASE_URL=https://dev.fintavapay.com/api/dev
FINTAVA_API_KEY=

# The Fintava customer whose wallet is debited by payouts: Tender's float.
# A key without this can resolve names but cannot pay anyone.
FINTAVA_SOURCE_ID=

# Verifies the HMAC-SHA512 signature on inbound webhooks. Events are rejected
# without it, so payouts would never be confirmed.
FINTAVA_WEBHOOK_SECRET=

# How often unsent payouts are pushed, and how long one may sit in a non-final
# state before it is chased with the provider rather than retried.
PAYOUT_INTERVAL=30s
PAYOUT_STALE_AFTER=2m

# ---------------------------------------------------------------- web
NEXT_PUBLIC_API_URL=http://localhost:8080
